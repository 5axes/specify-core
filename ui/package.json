{
  "name": "@draftwright/specify-ui",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Specify review and STEP diff components for the browser, on specify-core-wasm",
  "keywords": [
    "specify",
    "step",
    "pmi",
    "gd&t",
    "cad",
    "react"
  ],
  "homepage": "https://github.com/pzfreo/specify-ui#readme",
  "bugs": {
    "url": "https://github.com/pzfreo/specify-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pzfreo/specify-ui.git"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/specify-ui.js",
  "module": "./dist/specify-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/specify-ui.js"
    },
    "./style.css": "./dist/specify-ui.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/worker-url.mjs && tsc -p tsconfig.build.json && node scripts/rewrite-dts-imports.mjs",
    "test": "node --experimental-strip-types --test test/characteristics.test.mjs test/as9102.test.mjs test/specify-presentation.test.mjs test/graphical-pmi.test.mjs test/diff.test.mjs",
    "test:browser": "vite build --config vite.harness.config.ts && node test/step-diff-browser.mjs",
    "fetch:wasm": "node scripts/fetch-wasm.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "three": "0.186.x",
    "three-cad-viewer": "~5.1.3"
  },
  "dependencies": {
    "@draftwright/specify-core-wasm": "0.1.17"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "three-cad-viewer": "5.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
